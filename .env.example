# App Config
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s
APP_REQUEST_TIMEOUT=5s

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flashcart_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=15m
DB_MAX_CONN_LIFETIME=1h

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Logger
LOG_LEVEL=info
LOG_FORMAT=json
